// Cloudflare Workers の設定（OpenNext でビルドした Next.js アプリを動かす）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eijyukugohnd",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // ダッシュボードで設定した変数をデプロイのたびに消さない
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 記録の保存先（Cloudflare D1）。database_id は Cloudflare で作ったデータベースの ID
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eijyukugohnd",
      "database_id": "a9d484a1-77f7-4d6c-b11a-262ff35aff27"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "eijyukugohnd"
    }
  ],
  "observability": {
    "enabled": true
  }
}
